STORAGE_BACKEND=local # local|gcs
STORAGE_DIR=./.localdata/bucket # local path for file storage
GCS_BUCKET=haloheads-uploads # GCS bucket name
STORE_BACKEND=sqlite # sqlite|firestore
SQLITE_PATH=./.localdata/stats.db # local sqlite db path
GCP_PROJECT= # GCP project id for firestore
ANTHROPIC_API_KEY= # Anthropic API key
ANTHROPIC_MODEL= # model id (default claude-opus-4-8)
HALOHEADS_FAKE_EXTRACT= # set to 1 in tests to force fake extraction
