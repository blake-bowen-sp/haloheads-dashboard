STORAGE_BACKEND=local # local|gcs
STORAGE_DIR=./.localdata/bucket # local path for file storage
GCS_BUCKET=haloheads-uploads # GCS bucket name
STORE_BACKEND=sqlite # sqlite|firestore
SQLITE_PATH=./.localdata/stats.db # local sqlite db path
GCP_PROJECT= # GCP project id for firestore
GEMINI_API_KEY= # enables inline analysis in the web app (images + tab videos) — the deployed path
GEMINI_MODEL= # Gemini model id (default gemini-3.5-flash; handles both images and video)
HALOHEADS_FAKE_GEMINI= # set to 1 to force a deterministic fake multi-tab report inline (tests/E2E, no key)
ANTHROPIC_API_KEY= # optional — only for the automated scripts/analyze.py path (Claude Code stage/ingest needs no key)
ANTHROPIC_MODEL= # model id (default claude-opus-4-8)
HALOHEADS_FAKE_EXTRACT= # set to 1 in tests to force fake extraction (scripts/analyze.py path)
